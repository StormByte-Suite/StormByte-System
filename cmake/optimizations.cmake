# Optimizations
option(ENABLE_LTO "Link-time optimization. Not tied to the build type. Combines with ENABLE_PGO." ON)

# A plain set() only hides the cache in this directory. ENABLE_PGO forwards the
# cache, so the instrumented build would compile without these flags.
if(CMAKE_BUILD_TYPE STREQUAL "Release" AND MSVC)
	foreach(_opt_lang C CXX)
		set(_opt_var "CMAKE_${_opt_lang}_FLAGS")
		set(_opt_flags "${${_opt_var}}")
		foreach(_opt_flag IN ITEMS "/arch:AVX2" "/fp:fast" "/DNDEBUG")
			string(FIND "${_opt_flags}" "${_opt_flag}" _opt_at)
			if(_opt_at EQUAL -1)
				string(APPEND _opt_flags " ${_opt_flag}")
			endif()
		endforeach()
		string(STRIP "${_opt_flags}" _opt_flags)
		get_property(_opt_help CACHE "${_opt_var}" PROPERTY HELPSTRING)
		if(NOT _opt_help)
			set(_opt_help "Flags for ${_opt_lang}")
		endif()
		set("${_opt_var}" "${_opt_flags}" CACHE STRING "${_opt_help}" FORCE)
	endforeach()
	unset(_opt_lang)
	unset(_opt_var)
	unset(_opt_flags)
	unset(_opt_flag)
	unset(_opt_at)
	unset(_opt_help)
endif()

# Per-config variables win over the plain one, so set both.
set(CMAKE_INTERPROCEDURAL_OPTIMIZATION "${ENABLE_LTO}")
foreach(_lto_cfg DEBUG RELEASE RELWITHDEBINFO MINSIZEREL)
	set(CMAKE_INTERPROCEDURAL_OPTIMIZATION_${_lto_cfg} "${ENABLE_LTO}")
endforeach()
unset(_lto_cfg)
